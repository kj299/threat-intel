# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# API keys / secrets
.env
*.key
credentials.*

# Temp files
*.tmp
*.bak

# Claude Code scratch files (PR/issue body drafts)
.pr-body.md
.issue-comment.md

# Test-coverage artifacts (regenerable; coverage may be run from the repo root)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Claude Code runtime state (settings.local.json is tracked; locks are not)
.claude/*.lock
# Claude Code agent worktrees (managed by the SDK, not project files)
.claude/worktrees/

# Python artifacts
# Root-level now that Python lives in two places (mcp/ and evals/); mcp/ has
# its own .gitignore predating this, which stays as the more specific rule.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Threat-intel runs. reports/ is a FROZEN eval corpus (see CLAUDE.md); a
# dispatched run writes here instead and is published to the run summary,
# so a helpful run leaves no permanent history.
report-output/
