# threat-intel-mcp — environment-variable credentials (dev / local only)
# Copy this file to .env and fill in the keys you have; each feed is optional.
# NEVER commit .env to version control.
#
# Key sources:
#   QFEEDS_API_KEY     — https://tip.qfeeds.com (Manage API Keys)
#   ABUSEIPDB_API_KEY  — https://www.abuseipdb.com/account/api
#   VIRUSTOTAL_API_KEY         — https://www.virustotal.com/gui/user/apikey
#   OTX_API_KEY        — https://otx.alienvault.com/settings (API Integration)
#   SHODAN_API_KEY     — https://account.shodan.io (membership plan with query credits)
#   GREYNOISE_API_KEY  — https://viz.greynoise.io/account/ (Enterprise / GNQL plan)
#
# ThreatFox (abuse.ch) is a free public feed and needs NO key.
#   ANYRUN_API_KEY     — https://app.any.run (TI subscription; the full Authorization value)
#   INTEL471_EMAIL + INTEL471_API_KEY — https://portal.intel471.com/api (HTTP Basic)
#   CENSYS_API_ID + CENSYS_API_SECRET — https://search.censys.io/account/api
#
# CISA KEV is a free public government feed and needs NO key.
#   NVD_API_KEY        — https://nvd.nist.gov/developers/request-an-api-key
#                        (OPTIONAL: NVD works unauthenticated at a lower rate
#                        limit; a key raises it from 5 to 50 requests / 30s.)

QFEEDS_API_KEY=your-q-feeds-api-key-here
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
OTX_API_KEY=your-otx-api-key-here
SHODAN_API_KEY=your-shodan-api-key-here
GREYNOISE_API_KEY=your-greynoise-api-key-here
ANYRUN_API_KEY=API-Key your-anyrun-token-here
INTEL471_EMAIL=you@example.com
INTEL471_API_KEY=your-intel471-key-here
CENSYS_API_ID=your-censys-api-id-here
CENSYS_API_SECRET=your-censys-api-secret-here
NVD_API_KEY=your-nvd-api-key-here

# Production: use HashiCorp Vault instead of env vars. When VAULT_ADDR is set,
# the server selects VaultCredentialProvider automatically (see mcp/README.md).
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_ROLE_ID=<approle-role-id>
# VAULT_SECRET_ID=<approle-secret-id>
