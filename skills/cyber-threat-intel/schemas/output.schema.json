        "cwe_chains": {
          "type": "array",
          "description": "Weakness-class chains (primary -> resultant) per references/cwe-chaining.md. Each chain MUST carry at least one break_point (the defensive deliverable). ai_assist_factor records how much AI tooling lowers the chain's cost for an attacker.",
          "items": {
            "type": "object",
            "required": [
              "chain_id",
              "links",
              "break_points",
              "source"
            ],
            "properties": {
              "chain_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "chain_type": {
                "type": "string",
                "enum": [
                  "primary_resultant",
                  "composite",
                  "named_chain",
                  "multi_branch"
                ],
                "description": "Shape of the chain. primary_resultant=linear A->B->C; composite=weaknesses required together; named_chain=matches CWE-709; multi_branch=one link fans out to several downstream paths"
              },
              "cwe_view": {
                "type": "string",
                "description": "Provenance of the chain relationship, e.g. CWE-1000 (Research Concepts CanPrecede/CanFollow), CWE-709 (Named Chains), CWE-1003 (NVD mapping)"
              },
              "links": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "cwe_id",
                    "role"
                  ],
                  "properties": {
                    "cwe_id": {
                      "type": "string",
                      "pattern": "^CWE-[0-9]+$"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "primary",
                        "resultant"
                      ]
                    },
                    "mitre_id": {
                      "type": "string",
                      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
                    },
                    "tactic": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "string"
                    },
                    "detection_opportunity": {
                      "type": "string",
                      "description": "Observable this link produces (feeds the detective break-point and hunting queries)"
                    },
                    "data_source": {
                      "type": "string",
                      "description": "Where the detection_opportunity is observable, e.g. 'VPC flow logs', 'EDR process events'"
                    },
                    "source": {
                      "type": "string"
                    }
                  }
                }
              },
              "enabling_conditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ai_assist_factor": {
                "type": "string",
                "enum": [
                  "none",
                  "low",
                  "moderate",
                  "high"
                ],
                "description": "How much AI tooling lowers the chain's cost for an attacker (analysis input that raises defender urgency)"
              },
              "time_to_exploit": {
                "type": "object",
                "description": "Exploit-velocity context for the contributing CWE classes (e.g. from Zero Day Clock / CISA KEV). An accelerating trend plus moderate/high ai_assist_factor escalates priority.",
                "properties": {
                  "observed_days": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Median days from disclosure to in-the-wild exploitation"
                  },
                  "trend": {
                    "type": "string",
                    "enum": [
                      "accelerating",
                      "stable",
                      "decelerating"
                    ]
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              "terminal_impact": {
                "type": "string",
                "description": "Impact of the chain's terminal resultant link (drives the impact dimension of the chain score)"
              },
              "break_points": {
                "type": "array",
                "minItems": 1,
                "description": "Defensive deliverable: at least one control that invalidates the largest downstream tail",
                "items": {
                  "type": "object",
                  "required": [
                    "at_link",
                    "control"
                  ],
                  "properties": {
                    "at_link": {
                      "type": "string",
                      "pattern": "^CWE-[0-9]+$"
                    },
                    "control": {
                      "type": "string"
                    },
                    "control_type": {
                      "type": "string",
                      "enum": [
                        "preventive",
                        "detective",
                        "corrective"
                      ]
                    },
                    "rationale": {
                      "type": "string"
                    },
                    "mapped_mitigation": {
                      "type": "string"
                    },
                    "detection_telemetry": {
                      "type": "string",
                      "description": "For detective break-points: the concrete signal/data source the SOC hunts on"
                    }
                  }
                }
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "priority": {
                "type": "string",
                "enum": [
                  "P1-CRITICAL",
                  "P2-HIGH",
                  "P3-MEDIUM",
                  "P4-LOW",
                  "P5-INFO"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "High",
                  "Medium",
                  "Low"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "enum": [
                    "unknown",
                    "general knowledge",
                    "n/a"
                  ]
                }
              }
            }
          }
        },
